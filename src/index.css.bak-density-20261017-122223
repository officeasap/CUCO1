@import url("https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap");

@import "tailwindcss";

@theme {
  --color-smoked-powder: #1c1b1a;
  --color-smoked-card: #2f2f2c;
  --color-smoked-shadow: #080503;
  --color-smoked-ember: #c43503;
  --color-smoked-success: #56cd64;
  --color-smoked-warning: #e4b34a;
  --color-smoked-information: #62a8c7;
  --color-smoked-error: #d85c55;

  --color-text-on-card-primary: #e5decc;
  --color-text-on-card-secondary: #e5decc;
  --color-text-on-substrate-primary: #e5decc;
  --color-text-on-substrate-muted: #e5decc;

  --font-family-editorial: "EB Garamond", Georgia, serif;
  --font-family-interface: Inter, ui-sans-serif, sans-serif;
  --font-family-mono: "JetBrains Mono", monospace;

  --radius-card: 16px;
  --radius-card-sm: 16px;
  --radius-control: 16px;
  --radius-checkbox: 16px;
  --radius-radio: 999px;

  --spacing-1: 4px;
  --spacing-2: 8px;
  --spacing-3: 12px;
  --spacing-4: 16px;
  --spacing-6: 24px;
  --spacing-8: 32px;
  --spacing-12: 48px;
  --spacing-16: 64px;

  --ease-cathedral: cubic-bezier(0.4, 0, 0.2, 1);

  --breakpoint-xs: 520px;
  --breakpoint-sm: 600px;
  --breakpoint-md: 760px;
  --breakpoint-lg: 800px;
  --breakpoint-xl: 900px;
  --breakpoint-2xl: 1050px;
}

:root {
  --material-substrate: #1c1b1a;
  --material-card: #2f2f2c;
  --material-shadow: #080503;

  --operational-ember: #c43503;
  --operational-success: #56cd64;
  --operational-warning: #e4b34a;
  --operational-information: #62a8c7;
  --operational-error: #d85c55;

  --text-card-primary: #e5decc;
  --text-card-secondary: #e5decc;
  --text-substrate-primary: #e5decc;
  --text-substrate-muted: #e5decc;

  /*
   * ============================================================
   * CUCO PHYSICAL MATERIAL SYSTEM
   * ============================================================
   *
   * #2f2f2c = the physical object.
   * #080503 = the physical shadow material.
   *
   * Shadows are displaced behind the object rather than hugging
   * its perimeter. This creates lift without a decorative ring.
   */

  --shadow-physical:
    8px 10px 14px rgba(8, 5, 3, 0.68),
    -3px -3px 7px rgba(8, 5, 3, 0.22);

  --shadow-float:
    11px 13px 18px rgba(8, 5, 3, 0.72),
    -4px -4px 9px rgba(8, 5, 3, 0.24);

  --shadow-raised:
    8px 10px 14px rgba(8, 5, 3, 0.68),
    -3px -3px 7px rgba(8, 5, 3, 0.22);

  --shadow-raised-hover:
    10px 13px 17px rgba(8, 5, 3, 0.76),
    -4px -4px 9px rgba(8, 5, 3, 0.28);

  --shadow-pressed:
    inset 4px 5px 8px rgba(8, 5, 3, 0.72),
    inset -3px -3px 7px rgba(8, 5, 3, 0.28);

  /*
   * ============================================================
   * TYPOGRAPHIC MATERIAL
   * ============================================================
   *
   * Text receives the same Smudge Smoked Powder shadow material,
   * but at microscopic physical offsets.
   *
   * This is intentionally NOT a glow and NOT a text outline.
   */

  --text-shadow-physical:
    1px 1px 1px rgba(8, 5, 3, 0.72);

  --text-shadow-editorial:
    1px 1px 1.5px rgba(8, 5, 3, 0.78);

  --text-shadow-interface:
    1px 1px 1px rgba(8, 5, 3, 0.68);

  --text-shadow-mono:
    1px 1px 1px rgba(8, 5, 3, 0.72);

  /*
   * Focus remains an accessibility affordance only.
   * It is not part of the physical material system.
   */

  --shadow-contact:
    0 0 0 3px rgba(196, 53, 3, 0.22);

  --shell-width: 1200px;
  --motion-cathedral: cubic-bezier(0.4, 0, 0.2, 1);

  font-family: Inter, ui-sans-serif, sans-serif;
  color: var(--text-substrate-primary);
  background: var(--material-substrate);
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  min-width: 320px;
  background: var(--material-substrate);
  scroll-behavior: smooth;
}

body {
  min-width: 320px;
  min-height: 100svh;
  margin: 0;
  background: var(--material-substrate);
  color: var(--text-substrate-primary);
  font-family: Inter, ui-sans-serif, sans-serif;

  /*
   * Global interface typography receives the same physical
   * shadow material as the objects surrounding it.
   */

  text-shadow: var(--text-shadow-interface);
}

button,
input,
select,
textarea {
  font: inherit;
  text-shadow: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

button {
  cursor: pointer;
}

img,
svg {
  display: block;
  max-width: 100%;
}

a {
  color: inherit;
  text-decoration: none;
}

/* ============================================================
   GLOBAL PHYSICAL SURFACES
   ============================================================ */

:where(.bg-smoked-card) {
  background-color: var(--material-card);
  box-shadow: var(--shadow-physical);
}

:where(.rounded-card.bg-smoked-card),
:where(.rounded-control.bg-smoked-card) {
  background-color: var(--material-card);
  box-shadow: var(--shadow-physical);
}

/* ============================================================
   BUTTONS / LINKS / INTERACTIVE OBJECTS
   ============================================================ */

:where(button.bg-smoked-card),
:where(a.bg-smoked-card),
:where([role="button"].bg-smoked-card) {
  background-color: var(--material-card);
  box-shadow: var(--shadow-raised);

  transition:
    box-shadow 200ms var(--motion-cathedral),
    transform 200ms var(--motion-cathedral),
    color 200ms var(--motion-cathedral);
}

:where(button.bg-smoked-card:hover),
:where(a.bg-smoked-card:hover),
:where([role="button"].bg-smoked-card:hover) {
  box-shadow: var(--shadow-raised-hover);
  transform: translateY(-1px);
}

:where(button.bg-smoked-card:active),
:where(a.bg-smoked-card:active),
:where([role="button"].bg-smoked-card:active) {
  box-shadow: var(--shadow-pressed);
  transform: translateY(1px);
}

/* ============================================================
   FORMS / TEXTBOXES / SELECTS
   ============================================================ */

:where(
  input.bg-smoked-card,
  select.bg-smoked-card,
  textarea.bg-smoked-card
) {
  background-color: var(--material-card);
  box-shadow: var(--shadow-pressed);
  border: 0;
}

:where(
  input.bg-smoked-card:focus-visible,
  select.bg-smoked-card:focus-visible,
  textarea.bg-smoked-card:focus-visible
) {
  box-shadow:
    var(--shadow-pressed),
    var(--shadow-contact);
}

:where(
  input,
  select,
  textarea
) {
  border-color: transparent;
}

:where(
  input.bg-smoked-card,
  select.bg-smoked-card,
  textarea.bg-smoked-card
)::placeholder {
  color: var(--text-card-secondary);
  opacity: 0.68;
}

/* ============================================================
   IMAGE / VISUAL SURFACES
   ============================================================ */

:where(img.bg-smoked-card) {
  background-color: var(--material-card);
  box-shadow: var(--shadow-physical);
}

/* ============================================================
   TYPOGRAPHIC MATERIAL CLASSES
   ============================================================ */

.cuco-editorial {
  font-family: "EB Garamond", Georgia, serif;
  font-weight: 500;
  text-shadow: var(--text-shadow-editorial);
}

.cuco-interface {
  font-family: Inter, ui-sans-serif, sans-serif;
  text-shadow: var(--text-shadow-interface);
}

.cuco-mono {
  font-family: "JetBrains Mono", monospace;
  text-shadow: var(--text-shadow-mono);
}

.cuco-kicker {
  font-family: "JetBrains Mono", monospace;
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  line-height: 1.2;
  text-transform: uppercase;
  text-shadow: var(--text-shadow-mono);
}

.cuco-numeric {
  font-family: "JetBrains Mono", monospace;
  font-variant-numeric: tabular-nums;
  text-shadow: var(--text-shadow-mono);
}

/*
 * ============================================================
 * CUCO GLOBAL TYPOGRAPHIC SCALE
 * ============================================================
 *
 * Semantic headings have a hard global ceiling.
 *
 * Page-level Tailwind display utilities such as:
 *
 *   text-6xl
 *   text-7xl
 *   text-8xl
 *   text-9xl
 *   text-[7.5rem]
 *   text-[9rem]
 *
 * must NOT be allowed to turn ordinary CUCO headings into
 * billboard typography.
 *
 * Editorial hierarchy remains substantial, but controlled.
 */

/* Physical typography material */

h1,
h2,
h3,
h4,
h5,
h6 {
  text-shadow: var(--text-shadow-physical);
}

/*
 * H1
 *
 * 36px → fluid → 64px maximum.
 *
 * This is the primary page-heading ceiling.
 */

h1 {
  font-size: clamp(2.25rem, 5vw, 4rem) !important;
  line-height: 0.98 !important;
  letter-spacing: -0.025em;
}

/*
 * H2
 *
 * 28px → fluid → 48px maximum.
 *
 * This prevents page sections from becoming competing hero
 * headlines.
 */

h2 {
  font-size: clamp(1.75rem, 3.5vw, 3rem) !important;
  line-height: 1.02 !important;
  letter-spacing: -0.02em;
}

/*
 * H3
 *
 * 22px → fluid → 32px maximum.
 */

h3 {
  font-size: clamp(1.375rem, 2.5vw, 2rem) !important;
  line-height: 1.08 !important;
  letter-spacing: -0.01em;
}

/*
 * Supporting semantic headings stay deliberately compact.
 */

h4 {
  font-size: 1.5rem !important;
  line-height: 1.15 !important;
}

h5 {
  font-size: 1.25rem !important;
  line-height: 1.2 !important;
}

h6 {
  font-size: 1rem !important;
  line-height: 1.25 !important;
}

/*
 * Paragraphs, labels and navigation inherit the global
 * interface shadow naturally.
 */

p,
label,
nav,
legend {
  text-shadow: inherit;
}

/* ============================================================
   ACCESSIBILITY
   ============================================================ */

:focus-visible {
  outline: 3px solid var(--operational-ember);
  outline-offset: 3px;
}

::selection {
  background: var(--operational-ember);
  color: var(--text-card-primary);
}

/* ============================================================
   CUCO SHELL
   ============================================================ */

.cuco-shell {
  width: min(100% - 32px, var(--shell-width));
  margin-inline: auto;
}

/* ============================================================
   REDUCED MOTION
   ============================================================ */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
  }
}

/* CUCO GAVelfall faculty-name entrance */
.cuco-gavelfall-name {
  position: relative;
  isolation: isolate;
  width: fit-content;
  max-width: 100%;
}

.cuco-gavelfall-name__letters {
  display: inline;
}

.cuco-gavelfall-name__letter {
  display: inline-block;
  opacity: 0;
  transform: translate3d(0, -0.42em, 0) rotateX(-22deg);
  transform-origin: 50% 0%;
  will-change: transform, opacity;
}

.cuco-gavelfall-name.is-landed .cuco-gavelfall-name__letter {
  animation: cuco-gavelfall-drop 640ms cubic-bezier(0.18, 0.78, 0.22, 1.12) both;
  animation-delay: calc(var(--letter-index, 0) * 24ms);
}

.cuco-gavelfall-name::after {
  position: absolute;
  z-index: 2;
  top: 0.08em;
  bottom: 0.02em;
  left: -12%;
  width: 9%;
  content: '';
  opacity: 0;
  pointer-events: none;
  background: linear-gradient(90deg, transparent, rgba(229, 222, 204, 0.9), transparent);
  transform: skewX(-18deg) translateX(-160%);
}

.cuco-gavelfall-name.is-landed::after {
  animation: cuco-gavelfall-streak 360ms ease-in 940ms both;
}

@keyframes cuco-gavelfall-drop {
  0% { opacity: 0; transform: translate3d(0, -0.42em, 0) rotateX(-22deg); }
  68% { opacity: 1; transform: translate3d(0, 0.06em, 0) rotateX(2deg); }
  84% { opacity: 1; transform: translate3d(0, -0.025em, 0) rotateX(0); }
  100% { opacity: 1; transform: translate3d(0, 0, 0) rotateX(0); }
}

@keyframes cuco-gavelfall-streak {
  0% { opacity: 0; transform: skewX(-18deg) translateX(-160%); }
  20% { opacity: 0.95; }
  58% { opacity: 0.75; }
  100% { opacity: 0; transform: skewX(-18deg) translateX(1250%); }
}

@media (prefers-reduced-motion: reduce) {
  .cuco-gavelfall-name__letter {
    opacity: 1 !important;
    transform: none !important;
    animation: none !important;
    will-change: auto;
  }

  .cuco-gavelfall-name::after {
    display: none;
    animation: none !important;
  }
}
